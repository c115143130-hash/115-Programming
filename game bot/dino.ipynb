    "import time\n",
    "import pyautogui as pyg\n",
    "\n",
    "# PyAutoGUI 預設每次呼叫後會暫停 0.1 秒；關閉此延遲，避免取樣太慢而錯過快速經過的仙人掌。\n",
    "pyg.PAUSE = 0\n",
    "\n",
