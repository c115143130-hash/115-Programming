    "screen_width, screen_height = pyg.size()\n",
    "print(f\"目前螢幕大小：{screen_width} x {screen_height}\")\n",
    "\n",
    "# 留 3 秒切換到 Chrome，並將滑鼠停在恐龍前方、仙人掌身體會通過的位置。\n",
    "print(\"3 秒後開始：請切換到 Chrome，將滑鼠停在跑道上仙人掌會經過的位置！\")\n",
    "time.sleep(3)\n",
    "DETECTION_X, DETECTION_Y = pyg.position()\n",
    "if not (0 <= DETECTION_X < screen_width and 0 <= DETECTION_Y < screen_height):\n",
    "    raise ValueError(\"取得的滑鼠座標超出螢幕範圍。\")\n",
    "print(f\"已校準偵測點：({DETECTION_X}, {DETECTION_Y})\")\n",
    "pyg.press(\"space\")  # 空白鍵開始遊戲\n",
    "print(\"開始持續偵測仙人掌；在 Jupyter 按下停止即可結束。\")\n",
    "\n",
    "# 記錄上一輪是否已偵測到障礙物，避免同一根仙人掌仍在取樣區時重複起跳。\n",
    "obstacle_was_detected = False\n",
    "last_status_time = 0\n",
    "\n",
    "try:\n",
    "    while True:\n",
    "        # 在校準點附近取樣少數幾個像素，容忍滑鼠定位誤差與仙人掌邊緣的色差。\n",
    "        obstacle_detected = any(\n",
    "            max(pyg.pixel(x, DETECTION_Y + y_offset)) < 160\n",
    "            for x in (DETECTION_X - 6, DETECTION_X - 3, DETECTION_X, DETECTION_X + 3, DETECTION_X + 6)\n",
    "            for y_offset in (-3, 0, 3)\n",
    "            if 0 <= x < screen_width and 0 <= DETECTION_Y + y_offset < screen_height\n",
    "        )\n",
    "\n",
    "        # 只在障礙物剛出現時按一次空白鍵，避免連續多次跳躍。\n",
    "        if obstacle_detected and not obstacle_was_detected:\n",
    "            print(\"偵測到仙人掌，按下空白鍵跳躍！\")\n",
    "            pyg.press(\"space\")\n",
    "        obstacle_was_detected = obstacle_detected\n",
    "\n",
    "        # 若尚未偵測到障礙物，每秒顯示一次校準點顏色，方便確認取樣位置。\n",
    "        if not obstacle_detected and time.time() - last_status_time >= 1:\n",
    "            print(f\"偵測點顏色：{pyg.pixel(DETECTION_X, DETECTION_Y)}；請確認滑鼠位於跑道而非地面線。\")\n",
    "            last_status_time = time.time()\n",
    "\n",
    "        # 短暫等待降低 CPU 使用率，同時維持足夠快的偵測頻率。\n",
    "        time.sleep(0.01)\n",
    "except KeyboardInterrupt:\n",
    "    print(\"已停止小恐龍自動控制。\")"
   ]
